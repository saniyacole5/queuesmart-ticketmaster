PORT=3001
SESSION_TTL_MINUTES=60

DB_HOST=queuesmart-mysql-queuesmart-ticketmaster.i.aivencloud.com
DB_PORT=15771
DB_USER=queuesmart_app
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
DB_NAME=queuesmart_db

# Secure MySQL connection
DB_SSL_CA_PATH=./certs/ca.pem

# Assignment 4 authentication
# Use 'mysql for persistent authentication and services.
# The 'memory' option is retained temporarily for legacy tests.
# SQL services are enabled with SERVICES_STORAGE=mysql and require AUTH_STORAGE=mysql.
AUTH_STORAGE=mysql
SERVICES_STORAGE=mysql