PORT=3001
SESSION_TTL_MINUTES=60

DB_HOST=queuesmart-mysql-queuesmart-ticketmaster.i.aivencloud.com
DB_PORT=15771
DB_USER=queuesmart_app
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
DB_NAME=queuesmart_db

# Secure MySQL connection
DB_SSL_CA_PATH=./certs/ca.pem

# Authentication and service storage
# mysql = persistent Aiven MySQL storage
# memory = original Assignment 3 in-memory storage
# SERVICES_STORAGE=mysql requires AUTH_STORAGE=mysql
AUTH_STORAGE=mysql
SERVICES_STORAGE=mysql

# ---------------------------------------------------------------------------
# Write-oriented integration tests (a4-auth-db, a4-queues-db) refuse to run
# against this shared Aiven database -- they commit and then delete. Put their
# settings in a separate backend/.env.test pointing at a disposable LOCAL
# MySQL, then use `npm run test:db` / `npm run coverage:db`:
#
#   DB_HOST=127.0.0.1
#   DB_PORT=3307
#   DB_USER=queuesmart_app
#   DB_PASSWORD=local_only_password
#   DB_NAME=queuesmart_db
#   QUEUESMART_DB_TESTS=1
#
# Load backend/sql/001_schema.sql into that instance first. Bare `npm test`
# reads no env file at all, so it never reaches a database.
# ---------------------------------------------------------------------------