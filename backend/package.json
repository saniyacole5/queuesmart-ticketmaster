{
  "name": "queuesmart-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=src/**/*.js --test-coverage-exclude=src/server.js --test-coverage-lines=75 --test-coverage-functions=75",
    "db:check": "node --env-file-if-exists=.env scripts/check-db.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed:services": "node --env-file-if-exists=.env scripts/seed-services.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "mysql2": "^3.24.6"
  }
}
